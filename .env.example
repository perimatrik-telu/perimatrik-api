# Same variable names as the Laravel .env, so values can be copied over.
APP_ENV=production
APP_DEBUG=false
# Public base URL of this API. Used to build stored file URLs (…/storage/…),
# so it must match what Laravel used if you share the same database.
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
PORT=8000

FRONTEND_URL=https://www.perimatrik.org

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perimatrik
DB_USERNAME=root
DB_PASSWORD=

# Root of the public disk. Point this at the Laravel folder to keep existing
# uploads: ../perimatrik-api/storage/app/public
STORAGE_PATH=./storage/app/public

BCRYPT_ROUNDS=12
SANCTUM_TOKEN_PREFIX=

# Optional overrides (comma separated). Defaults mirror config/cors.php.
# CORS_ALLOWED_ORIGINS=https://perimatrik.org,https://dashboard.perimatrik.org
# CORS_ALLOWED_ORIGIN_PATTERNS=^https?://.*\.perimatrik\.org$
